{
  "name": "CodeSpit",
  "version": "1.0.0",
  "description": "AI-Ready Code Extractor with AST Parsing",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "codespit": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "watch": "nodemon --exec node --loader ts-node/esm src/index.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "ast",
    "parser",
    "code-extractor",
    "ai",
    "chunking"
  ],
  "author": "Talha",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.14.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@types/glob": "^9.0.0",
    "canvas": "^3.2.3",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "glob": "^10.3.10",
    "ora": "^8.0.1",
    "puppeteer": "^25.8.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.1",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}